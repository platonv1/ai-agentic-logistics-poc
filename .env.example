# Which LLM backend the three agents call. Defaults to "mock" if unset, which
# needs zero setup — the whole app is fully interactive with no keys or local
# servers. See README.md for what the mock provider actually does.
# One of: gemini | ollama | mock
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=

# Used when LLM_PROVIDER=ollama. Defaults to http://localhost:11434 — point
# this at wherever `ollama serve` is running.
OLLAMA_BASE_URL=http://localhost:11434
# Optional, defaults to llama3. Must be a model you've already pulled
# (`ollama pull llama3`).
OLLAMA_MODEL=llama3
